#!/usr/bin/env bash
# Everyday commands, with ESP-IDF's environment loaded for you (no `source
# export.sh` first), and any console command straight to the board. See
# `./sunsim help`.
#
# SUNSIM_IDF   the ESP-IDF checkout (default ~/.espressif/v6.1/esp-idf). Its
#              export.sh, not the activate_idf script: build/ was configured
#              with export.sh's Python and refuses another.
# SUNSIM_PORT  the board's serial port (default: the only /dev/ttyACM*).
# VCPKG_ROOT   the vcpkg checkout the host tests get boost-ext/ut from
#              (default ~/vcpkg; see test/host/CMakeLists.txt).
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
IDF=${SUNSIM_IDF:-$HOME/.espressif/v6.1/esp-idf}

usage() {
    cat <<'EOF'
usage: ./sunsim <command> [args]

  build            build the firmware
  flash            build and flash
  monitor          serial monitor and console (Ctrl+] quits)
  go               build, flash, then monitor
  <console command>   anything else runs on the board and prints its reply
                   (e.g. `./sunsim status`, `./sunsim intensity all 100`)
  cmd <command>    the same, for a name the script uses itself (`./sunsim cmd help`)
  test             build and run the host tests
  definition       generate or check the installation document's C++ tables
  idf <args>       any idf.py command (e.g. `./sunsim idf menuconfig`)

Console commands (also in `monitor`); `./sunsim cmd help` lists them all:

  status                                 time, sunrise/sunset, sky, mode, device links
  roles                                  which device has each role
  pair <role|cancel>                     the next device to join takes this role
  unpair <role|group|all>                forget a device, so it can be re-paired
  config [<setting> <value>]             hours, workhours, syncwindow, fade, sunshift,
                                         amber, ambersweep, clouds, clouddim, cloudcool,
                                         weather, days
  intensity [<light|group|all> <1-100>]  each light's peak brightness, %
  minlevel [<light|group|all> <1-254>]   each light's minimum level while on
  tune [<light|group|all> <level> [K] | save | off]   find each bulb's lowest visible level
  press single|double|hold               the button: daylight, red alert, all off
  fastday [on [seconds] | off]           a whole day in seconds, for testing
  sync                                   clock, forecast, weather and alerts now
  weather [simulate <what>]              the weather lights' view; or pretend (snow, warning, clear)
  wifi [add <ssid> [pw] | remove <ssid>]

<light> is WallA-WallE (east to west) or Work; <role> is a light or Button;
<group> is wall. Case doesn't matter.
EOF
}

idf_env() {
    if [[ ${IDF_PATH:-} == "$IDF" ]] && command -v idf.py >/dev/null; then
        return # already loaded
    fi
    if [[ ! -f $IDF/export.sh ]]; then
        echo "sunsim: no ESP-IDF at $IDF (set SUNSIM_IDF)" >&2
        exit 1
    fi
    # shellcheck disable=SC1091
    source "$IDF/export.sh" >/dev/null 2>&1 || {
        echo "sunsim: $IDF/export.sh failed; run it by hand to see why" >&2
        exit 1
    }
}

port() {
    if [[ -n ${SUNSIM_PORT:-} ]]; then
        echo "$SUNSIM_PORT"
        return
    fi
    local ports=(/dev/ttyACM*)
    if [[ ! -e ${ports[0]} ]]; then
        echo "sunsim: no board found (/dev/ttyACM*); plug it in or set SUNSIM_PORT" >&2
        exit 1
    fi
    if ((${#ports[@]} > 1)); then
        echo "sunsim: several ports (${ports[*]}); set SUNSIM_PORT" >&2
        exit 1
    fi
    echo "${ports[0]}"
}

# Sends one line to the console and prints what comes back up to the next
# prompt. The port is opened with pyserial's default DTR/RTS (both high):
# setting them low on open passes through DTR low / RTS high, which the
# C6's USB-serial takes as a reset.
console_cmd() {
    python - "$(port)" "$*" <<'EOF'
import sys, time, serial

port, command = sys.argv[1], sys.argv[2]
prompt = b"sunsim> "
s = serial.Serial(port, 115200, timeout=0.2)
s.reset_input_buffer()

s.write(b"\r\n")  # a fresh prompt, so the reply starts clean
deadline = time.time() + 2
buf = b""
while prompt not in buf and time.time() < deadline:
    buf += s.read(4096)

s.write(command.encode() + b"\r\n")
buf, deadline = b"", time.time() + 10
while time.time() < deadline:
    buf += s.read(4096)
    # The reply ends at the next prompt after the echoed command.
    echo = buf.find(command.encode())
    if echo >= 0 and buf.find(prompt, echo) >= 0:
        break
else:
    print("sunsim: no prompt back from the board (is `./sunsim monitor` open?)", file=sys.stderr)

text = buf.decode(errors="replace")
start = text.find(command)
start = text.find("\n", start) + 1 if start >= 0 else 0
end = text.find(prompt.decode(), start)
reply = text[start:end if end >= 0 else None].rstrip("\r\n").replace("\r", "")
print(reply)
# esp_console's words for an unknown command, or one that returned an error.
sys.exit(1 if "Unrecognized command" in reply or "non-zero error code" in reply else 0)
EOF
}

host_tests() {
    if [[ ! -f $ROOT/build-host/build.ninja ]]; then
        cmake --preset host -S "$ROOT/test/host" >/dev/null
    fi
    cmake --build "$ROOT/build-host"
    "$ROOT/build-host/sunsim_tests" | grep -Ev '^[IWE] \(' # results, not the core's logging
}

definition_check() {
    python3 "$ROOT/tools/generate_installation.py" --check
}

cd "$ROOT"
case ${1:-help} in
build)   definition_check; idf_env; idf.py build ;;
flash)   definition_check; idf_env; idf.py -p "$(port)" flash ;;
monitor) idf_env; idf.py -p "$(port)" monitor ;;
go)      definition_check; idf_env; idf.py -p "$(port)" flash monitor ;;
cmd)     shift; [[ $# -gt 0 ]] || { usage >&2; exit 1; }; idf_env; console_cmd "$@" ;;
test)    definition_check; python3 -m unittest discover -s "$ROOT/test/config"; idf_env; host_tests ;;
definition)
    shift
    case ${1:-check} in
        generate) python3 "$ROOT/tools/generate_installation.py" ;;
        check)    definition_check ;;
        *)        echo "usage: ./sunsim definition [generate|check]" >&2; exit 2 ;;
    esac
    ;;
idf)     shift; idf_env; idf.py "$@" ;;
help | -h | --help) usage ;;
*)       idf_env; console_cmd "$@" ;; # a console command
esac
