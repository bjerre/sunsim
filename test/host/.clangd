# The host tests have their own compile database (the build-host directory
# from the command in CMakeLists.txt).
CompileFlags:
  CompilationDatabase: ../../build-host
  Remove:
    - -fmodules-ts # GCC's module flags; clangd builds its own (--experimental-modules-support)
    - -fmodule-mapper=*
    - -fdeps-format=*
