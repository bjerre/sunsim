#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# end of Partition Table

#
# Zigbee
#
CONFIG_ZB_ENABLED=y
# end of Zigbee

#
# Wi-Fi (used once at boot to sync time over SNTP)
#
CONFIG_ESP_WIFI_ENABLED=y
# end of Wi-Fi

#
# C++ exceptions (off by default in ESP-IDF; not needed here, kept minimal)
#

#
# Console on the C6's built-in USB-Serial-JTAG port (/dev/ttyACM0), so the
# sunsim> REPL takes input over the same USB cable used for flashing
#
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# end of Console


#
# LVGL fonts used by the status display
#
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# end of LVGL fonts

#
# Normal log level (DEBUG floods the console with SPI/NVS traffic)
#
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# end of Log

#
# Task stacks: every task that posts events (main/startup, esp_timer for the
# heartbeat) needs room for a few Event copies (~256 B each) per post
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4608
# end of Task stacks
